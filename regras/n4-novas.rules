# --- n4: regras novas para os pontos cegos medidos a 2026-10-08 (Conde / lab) ---
# Scan às portas comuns: conta SYN de UMA origem para UM destino (track by_both),
# sem depender do window. 53, 80 e 443 ficam de fora (DNS e navegação dão rajadas
# legítimas). Validado offline: 0 falsos positivos em 6 cenários benignos; apanha
# 11 portas comuns x 2 tentativas. Limite: scans a menos de ~8 portas passam.
alert tcp any any -> any [21,22,23,25,88,110,135,137,138,139,143,161,389,445,465,514,587,636,853,993,995,1194,1433,1720,3306,3389,8080,8443,11211,27017,51820] (msg:"LAB SCAN portas comuns (SYN, origem->destino)"; flow:to_server; flags:S; threshold:type both, track by_both, count 15, seconds 30; classtype:attempted-recon; sid:3400130; rev:2;)
# NULL scan: nenhuma flag. Nunca é tráfego legítimo.
alert tcp any any -> any any (msg:"LAB SCAN NULL (-sN)"; flow:stateless; flags:0; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:3400131; rev:1;)
# FIN scan: só FIN, sem ACK. Um FIN legítimo leva sempre ACK.
alert tcp any any -> any any (msg:"LAB SCAN FIN (-sF)"; flow:stateless; flags:F; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:3400132; rev:1;)
# Porta 4444 sem exceção de porta de origem (fecha o desvio com -g 53).
alert tcp any any -> any 4444 (msg:"LAB porta 4444 (shell/Metasploit)"; flow:to_server; flags:S; threshold:type limit, track by_src, count 1, seconds 60; classtype:trojan-activity; sid:3400133; rev:1;)
# Versões "1 alerta por scan" das regras ruidosas -sX e -sA.
alert tcp any any -> any any (msg:"POSSBL PORT SCAN (NMAP -sX) BOTH"; flags:FPU; flow:to_server,stateless; threshold:type both, track by_src, count 3, seconds 120; classtype:attempted-recon; sid:3400105; rev:1;)
alert tcp any ![22,25,53,80,88,143,443,445,465,587,853,993,1194,8080,51820] -> any ![22,25,53,80,88,143,443,445,465,587,853,993,1194,8080,51820] (msg:"POSSBL PORT SCAN (NMAP -sA) BOTH"; flags:A; flow:stateless; window:1024; threshold:type both, track by_dst, count 20, seconds 70; classtype:attempted-recon; sid:3400104; rev:1;)
